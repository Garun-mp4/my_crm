{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "alwaysStrict": true,
    "noImplicitAny": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "src/*": ["./src/*"],
      "~/*": ["./*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.config.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.integration-test.ts"
  ],
  "references": [{ "path": "./tsconfig.spec.json" }]
}
